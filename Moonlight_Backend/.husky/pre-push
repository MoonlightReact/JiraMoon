#!/bin/sh
echo "🏛️ Verificando fronteiras arquiteturais..."
if ! npm run arch:check; then
  echo ""
  echo "❌ Violação de arquitetura! Push bloqueado."
  echo ""
  exit 1
fi

echo "🧪 Rodando testes antes do push..."
if ! npm test; then
  echo ""
  echo "❌ Testes falharam! Push bloqueado."
  echo ""
  exit 1
fi

echo "✅ Arquitetura e testes OK!"
